{
    "manifest_version": 3,
    "name": "YouTube RAG Chat",
    "version": "1.0.0",
    "description": "Chat with YouTube videos using RAG",

    "permissions": [
        "activeTab"
    ],

    "host_permissions": [
        "https://youtube-chat-api-siqa.onrender.com/*",
        "http://localhost:3000/*"
    ],

    "action": {
        "default_popup": "popup.html"
    }
}
